<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS" />

    <application
        android:name=".ASSApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:installLocation="internalOnly"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidSolidServices"
        tools:targetApi="31">

        <service
            android:name=".services.SolidAuthenticatorService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>

            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>
        <service
            android:name=".services.ASSAuthenticatorService"
            android:exported="true" />
        <service
            android:name=".services.ASSResourceService"
            android:exported="true" />
        <service
            android:name=".services.SolidDataModulesService"
            android:exported="true" />
        <service
            android:name=".services.ASSSharingService"
            android:exported="true" />
        <service
            android:name=".services.ASSNotificationsService"
            android:exported="true" />

        <!--
          Launched for-result by third-party apps through the client SDK's AuthorizeWithSolid
          contract. Exported by design: it only ever shows the consent picker, and a grant is
          recorded solely on the user's tap — the same trust model as any system account chooser.
        -->
        <activity
            android:name=".ui.AuthorizeActivity"
            android:exported="true"
            android:theme="@style/Theme.AndroidSolidServices.Dialog"
            android:excludeFromRecents="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter android:label="launch">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="@string/app_host_name"
                    android:path="@string/app_auth_redirect_path"
                    android:scheme="https" />
            </intent-filter>
        </activity>
    </application>

</manifest>