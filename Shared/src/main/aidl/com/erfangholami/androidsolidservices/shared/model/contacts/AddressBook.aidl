package com.erfangholami.androidsolidservices.shared.model.contacts;

/**
 * AIDL Parcelable declaration for the address-book summary type.
 *
 * Only types named directly in an AIDL signature need a declaration; each gets its own
 * file so imports resolve by filename. The Contact summary row these carry travels nested
 * inside its parent's parcel and needs none.
 */
parcelable AddressBook;
