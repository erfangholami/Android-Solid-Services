<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11+ (API 30) package visibility. Merged into every consuming app's manifest.
        - Solid Share is the host: without this, bindService() and the installed-app check
          cannot see it.
        - The retired Android Solid Services app is queried only so a device that still has it
          gets a message naming it; the SDK never binds to it.
        - The market intent lets Solid.hostInstallIntent() tell whether an app store is present.
    -->
    <queries>
        <package android:name="com.erfangholami.solidshare" />
        <package android:name="com.erfangholami.androidsolidservices" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application>

        <!--
          The other half of that visibility. A host matches this action in its own <queries> so
          it can read this app's label and icon from PackageManager every time it draws them.
          Without it the host knows only the package name, and a grant survives an update of
          either app while its row degrades to "not installed". The service is inert: it returns
          a null binder, so being exported exposes nothing.
        -->
        <service
            android:name="com.erfangholami.androidsolidservices.client.SolidClientMarkerService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.erfangholami.androidsolidservices.action.SOLID_CLIENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
