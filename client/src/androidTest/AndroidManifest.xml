<?xml version="1.0" encoding="utf-8"?><!--
    Instrumentation-only manifest.

    Two things make this suite work, and both live here rather than in code:

    1. android:process puts every fake in its own process, so binder genuinely marshals each
       argument and return value. Without it, Android passes object references directly within the
       process and the Parcelable path — the part most likely to break — would never run.

    2. The fakes answer to the production intent actions. ServiceConnector binds by action inside
       the package HostResolver names, and FakeSdk points the resolver at this APK, so the SDK's own
       entry points reach these services exactly as they would reach Solid Share.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Host for the Compose tests. turnScreenOn + showWhenLocked keep them from depending on
          whether the device happens to be awake, which otherwise makes them pass or fail based on
          when someone last touched it.
        -->
        <activity
            android:name="com.erfangholami.androidsolidservices.client.ui.ComposeHostActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name="com.erfangholami.androidsolidservices.services.ASSAuthenticatorService"
            android:exported="false"
            android:process=":fakeass">
            <intent-filter>
                <action android:name="com.erfangholami.androidsolidservices.action.AUTHENTICATOR" />
            </intent-filter>
        </service>
        <service
            android:name="com.erfangholami.androidsolidservices.services.ASSResourceService"
            android:exported="false"
            android:process=":fakeass">
            <intent-filter>
                <action android:name="com.erfangholami.androidsolidservices.action.RESOURCES" />
            </intent-filter>
        </service>
        <service
            android:name="com.erfangholami.androidsolidservices.services.SolidDataModulesService"
            android:exported="false"
            android:process=":fakeass">
            <intent-filter>
                <action android:name="com.erfangholami.androidsolidservices.action.DATA_MODULES" />
            </intent-filter>
        </service>
        <service
            android:name="com.erfangholami.androidsolidservices.services.ASSSharingService"
            android:exported="false"
            android:process=":fakeass">
            <intent-filter>
                <action android:name="com.erfangholami.androidsolidservices.action.SHARING" />
            </intent-filter>
        </service>
        <service
            android:name="com.erfangholami.androidsolidservices.services.ASSNotificationsService"
            android:exported="false"
            android:process=":fakeass">
            <intent-filter>
                <action android:name="com.erfangholami.androidsolidservices.action.NOTIFICATIONS" />
            </intent-filter>
        </service>
        <!--
            The real ResourceBinder behind the real guard. Three actions, one service: the action
            the test binds with chooses the grant it is answered under, which is the only way to
            configure a service in another process without a channel of its own.
        -->
        <service
            android:name="com.erfangholami.androidsolidservices.services.RealHostResourceService"
            android:exported="false"
            android:process=":fakeass">
            <intent-filter>
                <action android:name="com.erfangholami.androidsolidservices.client.test.GUARD_VIEW" />
                <action android:name="com.erfangholami.androidsolidservices.client.test.GUARD_EDIT" />
                <action android:name="com.erfangholami.androidsolidservices.client.test.GUARD_NONE" />
            </intent-filter>
        </service>
        <service
            android:name="com.erfangholami.androidsolidservices.client.internal.NullBindingService"
            android:exported="false"
            android:process=":fakeass">
            <intent-filter>
                <action android:name="com.erfangholami.androidsolidservices.client.test.NULL_BINDING" />
            </intent-filter>
        </service>
    </application>

</manifest>
